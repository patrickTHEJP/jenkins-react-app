pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/patrickTHEJP/jenkins-react-app.git'
            }
        }

        stage('Run Test') {
            steps {
                sh 'npm ci'
                sh 'npm test -- --run'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Archive Artifact') {
            steps {
                sh 'tar -czf react-app-${BUILD_NUMBER}.tar.gz dist Dockerfile'

                archiveArtifacts(
                    artifacts: 'react-app-*.tar.gz',
                    fingerprint: true
                )
            }
        }
    }
}